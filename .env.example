# ---------------------------------------------------------------------------
# Atomic Shelf Outreach - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the app and by the Prisma CLI (migrations).
DATABASE_URL="postgresql://outreach:CHANGE_ME@localhost:5432/outreach?schema=public"

# Optional: dedicated database used by `npm run test:db`.
# When set, database integration tests run against this URL instead of the app
# database. If unset, database tests are skipped automatically.
TEST_DATABASE_URL="postgresql://outreach:CHANGE_ME@localhost:5432/outreach_test?schema=public"

# Internal admin authentication (single operator account, V1).
ADMIN_USERNAME="operator"
ADMIN_PASSWORD="CHANGE_ME"

# Random 32+ byte string used to sign the admin session cookie.
SESSION_SECRET="CHANGE_ME_use_openssl_rand_hex_32"

# Upload limits (bytes) / import limits (rows).
MAX_UPLOAD_BYTES="10485760"
MAX_IMPORT_ROWS="20000"

# Node environment: development | production | test
NODE_ENV="development"
